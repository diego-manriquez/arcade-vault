# Copia este archivo a .env.local y completa los valores. NUNCA subas .env.local.

# API key de https://resend.com/api-keys (solo servidor, sin prefijo NEXT_PUBLIC_).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Destinatario del formulario de contacto de /acerca-de.
# Con el remitente onboarding@resend.dev, Resend SOLO entrega al correo
# dueño de la cuenta de Resend: usa ese mismo correo aquí.
CONTACT_TO_EMAIL=tu-correo@ejemplo.com

# Remitente. Para usar un dominio propio, verifícalo antes en Resend (DNS).
CONTACT_FROM_EMAIL=Arcade Vault <onboarding@resend.dev>
